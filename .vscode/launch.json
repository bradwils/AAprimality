{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug primality",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/primality",
            "args": ["run", "all", "561", "97"],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "preLaunchTask": "CMake: build (Debug)",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}
